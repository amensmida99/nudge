<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for the NudgeShareExtension target.
  The App Group MUST match the main app's App Group and AppConstants.appGroupID.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.nudge.shared</string>
    </array>
</dict>
</plist>
